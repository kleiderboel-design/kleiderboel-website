# Cloudflare Pages: beveiligingsheaders en caching (zelfde als in netlify.toml)

# Alleen op *.pages.dev (productie- en previewadressen van het project): niet laten indexeren.
# Het eigen domein kleiderboel.nl krijgt deze header NIET, dus daar mag Google indexeren.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Brochure-PDF niet apart laten indexeren (datums verouderen); de pagina zelf blijft indexeerbaar.
/wp-content/uploads/*.pdf
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/img/*
  Cache-Control: public, max-age=86400
